diff --git a/src/ggml-vulkan/ggml-vulkan-device-policy.hpp b/src/ggml-vulkan/ggml-vulkan-device-policy.hpp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/ggml-vulkan-device-policy.hpp
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <vulkan/vulkan_core.h>
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// Device-local does not imply device-only: some drivers expose a CPU-visible
+// device-local type with much lower shader throughput. Keep it as a fallback,
+// but rank device-only types first when the caller needs no host access.
+inline std::vector<uint32_t> ggml_vk_memory_type_indices(
+        const VkPhysicalDeviceMemoryProperties & properties,
+        const VkMemoryRequirements & requirements, VkMemoryPropertyFlags flags) {
+    std::vector<uint32_t> indices;
+    for (uint32_t i = 0; i < properties.memoryTypeCount; ++i) {
+        const auto & type = properties.memoryTypes[i];
+        if ((requirements.memoryTypeBits & (uint32_t{1} << i)) &&
+            (type.propertyFlags & flags) == flags &&
+            properties.memoryHeaps[type.heapIndex].size >= requirements.size) {
+            indices.push_back(i);
+        }
+    }
+    if (flags == VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) {
+        std::stable_partition(indices.begin(), indices.end(), [&](uint32_t i) {
+            return !(properties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+        });
+    }
+    return indices;
+}
+
+inline bool ggml_vk_prefer_device_only_memory(bool uma, bool prefer_host_visible,
+                                              bool disable_host_visible) {
+    return !uma && (disable_host_visible || !prefer_host_visible);
+}
+
+enum class ggml_vk_conv_direct_variant { none, e16, e32, e64, w128 };
+
+// Match conv_direct_1d.comp: weights BM*(BK/2+1) vec2, the circular
+// XS_ROWS*(BN+XS_HALO) float window, and two BK/2 uvec2 decode tables.
+constexpr uint32_t ggml_vk_conv_direct_shared_bytes(uint32_t bm, uint32_t bn) {
+    constexpr uint32_t bk = 32, rows = 12, halo = 72;
+    return bm * (bk / 2 + 1) * 2 * sizeof(float)
+         + rows * (bn + halo) * sizeof(float)
+         + 2 * (bk / 2) * 2 * sizeof(uint32_t);
+}
+
+inline ggml_vk_conv_direct_variant ggml_vk_select_conv_direct_variant(
+        int64_t output_channels, const VkPhysicalDeviceLimits & limits) {
+    const auto supported = [&](uint32_t threads, uint32_t bm, uint32_t bn) {
+        return threads <= limits.maxComputeWorkGroupInvocations &&
+               threads <= limits.maxComputeWorkGroupSize[0] &&
+               ggml_vk_conv_direct_shared_bytes(bm, bn) <= limits.maxComputeSharedMemorySize;
+    };
+    if (output_channels <= 16 && supported(128, 16, 64)) return ggml_vk_conv_direct_variant::e16;
+    if (output_channels <= 32 && supported(128, 32, 64)) return ggml_vk_conv_direct_variant::e32;
+    if (supported(256, 64, 128)) return ggml_vk_conv_direct_variant::w128;
+    // Vulkan's minimum 16 KiB shared memory / 128 threads can run e64,
+    // even though the preferred w128 tile needs 18,560 bytes / 256 threads.
+    if (supported(128, 64, 64)) return ggml_vk_conv_direct_variant::e64;
+    if (supported(128, 32, 64)) return ggml_vk_conv_direct_variant::e32;
+    if (supported(128, 16, 64)) return ggml_vk_conv_direct_variant::e16;
+    return ggml_vk_conv_direct_variant::none;
+}
